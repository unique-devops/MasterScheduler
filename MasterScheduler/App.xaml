<Application x:Class="MasterScheduler.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"        
             xmlns:views="clr-namespace:MasterScheduler.Views"
             xmlns:vm="clr-namespace:MasterScheduler.ViewModels"
             xmlns:local="clr-namespace:MasterScheduler"
             xmlns:ctr="clr-namespace:MasterScheduler.Converter"
             >
    <Application.Resources>
        <ResourceDictionary>
            <DropShadowEffect x:Key="DropShadowEffect"
                      Color="Black"
                      Direction="270"
                      ShadowDepth="5"
                      BlurRadius="10"
                      Opacity="0.5"/>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <ctr:DestinationIconConverter x:Key="IconConverter"/>
        <ctr:JobTypeToImageConverter x:Key="JobTypeIconConverter"/>
        <ctr:LevelToColorConverter x:Key="LevelToColorConverter"/>

       
        <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Application.Resources>
</Application>
