<Window x:Class="MasterScheduler.Views.ActivateEditionViewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:local="clr-namespace:MasterScheduler.Views"
        mc:Ignorable="d"
        Title="Activate Edition" WindowStyle="ToolWindow" Height="280" Width="620" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>
    <Border Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock FontWeight="SemiBold">PC ID:</TextBlock>
                <TextBlock FontWeight="SemiBold" Margin="10,0" Text="{Binding PCID , UpdateSourceTrigger=PropertyChanged}"></TextBlock>
                <Button Visibility="{Binding IsCopied, Converter={StaticResource FalseToVisibleConverter}}" Margin="10,0" Background="Transparent" BorderThickness="0" Command="{Binding CopyCommand}">
                    <fa:ImageAwesome Icon="Copy" Width="14" Height="14" Foreground="#28A745" Margin="0,0,8,0"/>
                </Button>
                <TextBlock Visibility="{Binding IsCopied, Converter={StaticResource BoolToVisibilityConverter}}" FontWeight="SemiBold" Margin="10,0">
                     <fa:ImageAwesome Icon="Check" Width="14" Height="14" Foreground="#28A745" Margin="0,0,8,0"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <TextBlock TextAlignment="Center">
                    <fa:ImageAwesome Icon="Key" Width="70" Height="70" Foreground="Gray"/>
                </TextBlock>
                <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="Bold">Enter License  Key</TextBlock>
                <TextBox x:Name="txtLicKey" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Padding="5" Background="LightYellow" TextAlignment="Center"  MinWidth="580">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>
            <TextBlock Grid.Row="2" HorizontalAlignment="Center" Foreground="Red" Text="{Binding ErrorMessage, UpdateSourceTrigger=PropertyChanged}"></TextBlock>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ActivateButton"
                  Content="Activate"                 
                  Command="{Binding ActivateKeyCommand}"
                  Cursor="Hand">

                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="DarkSeaGreen"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Width" Value="100"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="Margin" Value="7,0"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12"
                                    ShadowDepth="2"
                                    Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>

                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#059669"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                    </Button.Style>
                </Button>
                <Button x:Name="CancelButton"
                  Content="Cancel"                 
                  Command="{Binding CancelCommand}"
                  Cursor="Hand">

                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="IndianRed"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Width" Value="100"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="Margin" Value="7,0"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12"
                                ShadowDepth="2"
                                Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>

                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#059669"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
