<UserControl x:Class="MasterScheduler.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:local="clr-namespace:MasterScheduler.Views"
        xmlns:crt="clr-namespace:MasterScheduler.Converter"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <crt:RunningToVisibilityConverter x:Key="RunningToVisibilityConverter"/>
        <crt:NotRunningToVisibilityConverter x:Key="NotRunningToVisibilityConverter"/>
        <crt:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Left">
            <Button Width="120" Margin="5" ToolTip="Add a new job" Command="{Binding AddJobCommand}">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="PlusCircle" Width="16" Height="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Add Job"/>
                </StackPanel>
            </Button>
            <Button Width="120" Margin="5" ToolTip="Enable all jobs">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="ToggleOn" Width="16" Height="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Enable All"/>
                </StackPanel>
            </Button>
            <Button Width="120" Margin="5" ToolTip="Disable all jobs">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="ToggleOff" Width="16" Height="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Disable All"/>
                </StackPanel>
            </Button>
            <Button Width="120" Margin="5" ToolTip="Open global configuration">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Cogs" Width="16" Height="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Config"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Job Monitor Grid -->
        <DataGrid Grid.Row="1" x:Name="dataGrid"
                  ItemsSource="{Binding Jobs}" 
                  SelectedItem="{Binding SelectedJob ,Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"                 
                  HeadersVisibility="Column"                 
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="None"
                  Background="White"
                  BorderBrush="#DDD"
                  BorderThickness="1"
                  RowHeight="30"
                  FontSize="16"   
                  Focusable="True"                  
                  HorizontalGridLinesBrush="#EEE"
                  VerticalGridLinesBrush="#EEE" PreviewKeyDown="DataGrid_KeyDown">
            <DataGrid.Resources>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                </Style>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Black"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
            </DataGrid.Resources>
            
            <!--<DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Style.Triggers>
                        <Trigger Property="IsSelected"
                        Value="True">
                            <Setter Property="Background"
                        Value="White" />
                            <Setter Property="Foreground"
                        Value="Black" />
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>-->           
            
            <DataGrid.Style>
                <Style TargetType="DataGrid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Jobs.Count}" Value="0">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGrid">
                                        <Grid Background="White">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="No job available"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   FontSize="16"
                                                   Foreground="Gray"
                                                   FontWeight="SemiBold"/>
                                                <Button  Command="{Binding AddJobCommand}">
                                                    <fa:ImageAwesome Icon="PlusCircle" Width="16" Height="16" Margin="0,0,5,0"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Job Id"  Binding="{Binding Id}" Width="50">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="5 0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Job Name"  Binding="{Binding Name}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="5 0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Job Type" Binding="{Binding JobType}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!--<DataGridTextColumn Header="Status" Binding="{Binding status}" Width="120"/>-->
                <DataGridTextColumn Header="Last Run" Binding="{Binding LastRunAt}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Next Run" Binding="{Binding NextRunAt}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

               
                

                <DataGridTemplateColumn Header="Status" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Spinner GIF -->
                                <!-- Animated GIF -->
                                <Image gif:ImageBehavior.AnimatedSource="/Assets/loading.gif"
                                       Width="20" Height="20"
                                       Visibility="{Binding Status, Converter={StaticResource RunningToVisibilityConverter}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                                <!-- Text -->
                                <TextBlock Text="{Binding Status}"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Status, Converter={StaticResource NotRunningToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- Action Buttons Column -->
                <DataGridTemplateColumn Header="Actions" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Menu Visibility="{Binding Status, Converter={StaticResource NotRunningToVisibilityConverter}}">
                                    <MenuItem Padding="2">
                                        <MenuItem.Header>
                                            <fa:ImageAwesome Icon="EllipsisV" Width="14" Height="14"/>
                                        </MenuItem.Header>
                                        <MenuItem Header="Run now" Command="{Binding DataContext.RunNowJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <MenuItem.Icon>
                                                <fa:ImageAwesome Icon="Play" Width="14" Height="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Delete" Command="{Binding DataContext.DeleteJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <MenuItem.Icon>
                                                <fa:ImageAwesome Icon="Remove" Width="14" Height="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Config" Command="{Binding DataContext.ConfigJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <MenuItem.Icon>
                                                <fa:ImageAwesome Icon="Cogs" Width="14" Height="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuItem>
                                </Menu>
                                <Button Width="30" Height="30"  Padding="2" ToolTip="Stop Job" Visibility="{Binding Status, Converter={StaticResource RunningToVisibilityConverter}}"
                                        Command="{Binding DataContext.StopJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" Margin="2">
                                    <fa:ImageAwesome Icon="Stop" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
        
    </Grid>
</UserControl>
