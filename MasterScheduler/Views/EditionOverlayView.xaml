<UserControl x:Class="MasterScheduler.Views.EditionOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MasterScheduler.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#CC000000">
        <Border  Background="#1E1E1E" VerticalAlignment="Center" HorizontalAlignment="Center" 
                CornerRadius="10" Width="700" Padding="15" BorderBrush="#444" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Choose Your Edition" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Unlock the full power of Master Scheduler" Foreground="#AAA" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                        CornerRadius="12"
                        Background="White"
                        Padding="20"
                        Margin="10"
                        BorderBrush="#DADADA"
                        BorderThickness="1">

                        <StackPanel>

                            <TextBlock Text="LITE"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

                            <TextBlock Text="₹ 3,000 / License"
                   FontSize="18"
                   Foreground="#2E7D32"
                   FontWeight="SemiBold"
                   Margin="0,10"
                   HorizontalAlignment="Center"/>

                            <Separator Margin="0,10"/>

                            <!-- Features -->
                            <TextBlock Text="FEATURES"
                   FontWeight="Bold"
                   Margin="0,5"/>

                            <TextBlock Text="✔ Backup Scheduler"/>
                            <TextBlock Text="✔ Manual  Automatic Backup"/>
                            <TextBlock Text="✔ Compression"/>
                            <TextBlock Text="✔ Encryption"/>
                            <TextBlock Text="✖ Max 5 Databases"
                   Foreground="DarkRed"
                   FontWeight="SemiBold"/>

                            <Separator Margin="10"/>

                            <!-- Storage -->
                            <TextBlock Text="BACKUP DESTINATION"
                   FontWeight="Bold"
                   Margin="0,5"/>

                            <TextBlock Text="✔ Local Folder"/>
                            <TextBlock Text="✔ Network Path (NAS)"/>
                            <TextBlock Text="✔ FTP"/>
                            <TextBlock Text="✖ Google Drive"
                   Foreground="Gray"/>
                            <TextBlock Text="✖ Dropbox"
                   Foreground="Gray"/>

                            <Button Content="Buy Lite"
                Height="36"
                Margin="0,20,0,0"
                Background="#1976D2"
                Foreground="White"/>
                        </StackPanel>
                    </Border>


                    <Border Grid.Column="1"
        CornerRadius="12"
        Background="#E8F5E9"
        Padding="20"
        Margin="10"
        BorderBrush="#2E7D32"
        BorderThickness="2">

                        <StackPanel>

                            <TextBlock Text="PRO"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

                            <TextBlock Text="₹ 10,000 / License"
                   FontSize="18"
                   Foreground="#1B5E20"
                   FontWeight="SemiBold"
                   Margin="0,10"
                   HorizontalAlignment="Center"/>

                            <Separator Margin="0,10"/>

                            <!-- Features -->
                            <TextBlock Text="FEATURES"
                   FontWeight="Bold"
                   Margin="0,5"/>

                            <TextBlock Text="✔ Backup Scheduler"/>
                            <TextBlock Text="✔ Manual Automatic Backup"/>
                            <TextBlock Text="✔ Compression"/>
                            <TextBlock Text="✔ Encryption"/>
                            <TextBlock Text="✔ Unlimited Databases"
                   FontWeight="SemiBold"/>

                            <Separator Margin="10"/>

                            <!-- Storage -->
                            <TextBlock Text="BACKUP DESTINATION"
                   FontWeight="Bold"
                   Margin="0,5"/>

                            <TextBlock Text="✔ Local Folder"/>
                            <TextBlock Text="✔ Network Path (NAS)"/>
                            <TextBlock Text="✔ FTP / SFTP"/>
                            <TextBlock Text="✔ Google Drive"/>
                            <TextBlock Text="✔ Dropbox"/>

                            <Button Content="Buy Pro"
                Height="36"
                Margin="0,20,0,0"
                Background="#2E7D32"
                Foreground="White"/>
                        </StackPanel>
                    </Border>

                </Grid>

                <Button Content="Close" Command="{Binding GoBackCommand}" Background="Transparent" Foreground="Red" BorderThickness="0" Padding="5" Margin="0,20,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Border Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Activate Your Trial" Foreground="White" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock Text="Enter email to receive your trial key" Foreground="#AAA" Margin="0,10"/>

                <TextBox Text="{Binding UserEmail, UpdateSourceTrigger=PropertyChanged}" 
         Background="#333" Foreground="White" Padding="10" Margin="0,10"/>

                <Button Content="Confirm &amp; Activate" 
        Command="{Binding ActivateTrialCommand}"
        Background="#22C55E" Foreground="White" FontWeight="Bold"/>

                <Button Content="Go Back" 
        Command="{Binding ShowEmailFormCommand}" 
        CommandParameter="false" Background="Transparent" Foreground="#666"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
