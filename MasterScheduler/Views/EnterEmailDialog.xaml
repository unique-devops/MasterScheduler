<Window x:Class="MasterScheduler.Views.EnterEmailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterScheduler.Views"
        mc:Ignorable="d"
        Title="EnterEmailDialog" Height="150" Width="400" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">
    <!-- Outer Shadow -->
    <Border CornerRadius="12"
            Background="White"
            Padding="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
           
            <!-- Email Input -->
            <TextBox x:Name="EmailTextBox" Style="{StaticResource PlaceholderTextBox}" Tag="Enter Email"
                     Grid.Row="0" Padding="5"                
                     FontSize="14" Margin="0,10"                                     
                     Foreground="Black"                                          
                     VerticalContentAlignment="Center"
                     TextChanged="EmailTextBox_TextChanged"
                     />

            <!-- Buttons -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancel"
                        Width="90"
                        Height="34"
                        Margin="0,0,10,0"
                        Background="#333"
                        Foreground="White"
                        BorderBrush="#444"
                        Click="Cancel_Click"/>

                <Button x:Name="ConfirmButton"
                        Content="Confirm"
                        Width="110"
                        Height="34"
                        Background="#F5A623"
                        Foreground="Black"
                        FontWeight="SemiBold"
                        IsEnabled="False"
                         Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
