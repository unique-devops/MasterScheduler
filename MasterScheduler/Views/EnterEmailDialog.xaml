<Window x:Class="MasterScheduler.Views.EnterEmailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterScheduler.Views"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        Title="EnterEmailDialog" Height="130" Width="400" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">
    <!-- Outer Shadow -->
    <Border CornerRadius="12"
            Background="SkyBlue"
            Padding="15">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <!-- Email Input -->
            <TextBox x:Name="EmailTextBox" Style="{StaticResource PlaceholderTextBox}" Tag="Enter Email"
                     Grid.Row="0" Grid.Column="0" Padding="5"                
                     FontSize="14" Margin="0,10"                                     
                     Foreground="Black" BorderThickness="0"                                       
                     VerticalContentAlignment="Center"
                     TextChanged="EmailTextBox_TextChanged"
                     />

            <Button x:Name="ConfirmButton" Grid.Row="0" Grid.Column="1"                
            Height="30"
            Background="#F5A623"
            Foreground="Black"
            BorderBrush="Snow"
            FontWeight="SemiBold"            
            Click="Confirm_Click">
                <fa:ImageAwesome Icon="ArrowRight" Height="15" />
            </Button>
            <!-- Buttons -->
            <Button Content="Cancel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"        
        Height="34"
        Margin="0,0,10,0"
        Background="#333"
        Foreground="White"
        BorderBrush="#444"
        Click="Cancel_Click"/>
        </Grid>
    </Border>
</Window>
