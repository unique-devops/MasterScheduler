<Window x:Class="MasterScheduler.Views.GoogleDriveConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterScheduler.Views"
        mc:Ignorable="d"
        Title="Google Drive Authorization" Height="380" Width="400" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel Margin="12">
                <TextBlock Text="Google Drive Configuration" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <GroupBox Header="Account Information" Margin="0,0,0,12">
                    <Grid Margin="12">
                        <Button x:Name="BtnAuthorize" Grid.Column="1" Content="Link Account" Click="BtnAuthorize_Click" Margin="10,0,0,0" Padding="10,2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="Authorize Google Drive" />
                                    <Setter Property="Background" Value="#4285F4" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Content" Value="Connected ✅" />
                                            <Setter Property="Background" Value="#34A853" />
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </GroupBox>

                <TextBlock Text="Backup Folder" Margin="0,5"/>
                <DockPanel>
                <TextBox x:Name="TxtFolderPath" IsReadOnly="True" Text="MSDataBackups"/>
                <Button x:Name="btnCreateDriveFoder" Content="Create" Width="70" HorizontalAlignment="Right" Click="BtnCreateDriveFolder_Click"/>
            </DockPanel>

                <Separator Margin="0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnTest" Content="Test" Margin="5" Background="LightGray" Click="btnTest_Click"/>
                    <Button Content="Save Settings" Click="btnSave_Click" Margin="5" Background="SkyBlue"/>
                </StackPanel>
            </StackPanel>
    </Grid>
</Window>
