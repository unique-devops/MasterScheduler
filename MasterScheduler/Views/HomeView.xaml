<UserControl x:Class="MasterScheduler.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MasterScheduler.Views" xmlns:controls="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="White">
    <Grid Background="#F5F6FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border CornerRadius="10"
                Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Backup Jobs"  FontSize="16"  FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="View and manage all Jobs" Foreground="Gray"/>

                <TextBox Grid.Row="1"
                    Grid.Column="1"                                        
                    VerticalContentAlignment="Center"
                    Text="">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Padding" Value="7,4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                    <Button Background="White" Margin="5,0,0,0" Content="Refresh">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Padding" Value="7,4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Margin="5,0,0,0" BorderThickness="0" Background="Blue" Foreground="White" Content="+ New Job" Command="{Binding AddJobCommand}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Padding" Value="7,4"/>
                            </Style>

                        </Button.Resources>
                    </Button>
                </StackPanel>

            </Grid>

        </Border>

        <!-- Filters -->

        

        <!-- Cards -->


        <ListBox Grid.Row="1" ItemsSource="{Binding BackupJobs}"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         ScrollViewer.VerticalScrollBarVisibility="Auto"
         Background="Transparent"
         BorderThickness="0">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <!-- Disables selection and mouse interactions -->
                    <Setter Property="Focusable" Value="False"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingWrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:JobCardView/>
                </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

       

    </Grid>
</UserControl>
