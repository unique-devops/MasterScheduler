<UserControl x:Class="MasterScheduler.Views.JobCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MasterScheduler.Views" xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d"
             Width="400"
             Height="245">
    <UserControl.Resources>

        <!-- Card Shadow -->        
        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" 
                          Direction="270" 
                          RenderingBias="Quality" 
                          ShadowDepth="3" 
                          Opacity="0.15"/>

        <!-- Professional ContextMenu Style -->
        <Style x:Key="ProfessionalContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Professional MenuItem Style -->
        <Style x:Key="ProfessionalMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Semibold"/>
            <Setter Property="Padding" Value="12,8,16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="4"
                            Margin="2,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Space reserved for an icon if needed -->
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="IconGroup"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Content -->
                                <ContentPresenter Grid.Column="1" 
                                              ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover State: Elegant Light Blue or Gray Highlight -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="#EDF2F7"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <!-- Disabled State -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Professional Separator Style -->
        <Style x:Key="ProfessionalSeparator" TargetType="Separator">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Margin" Value="4,4,4,4"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="{TemplateBinding Height}" 
                            Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#F5F6FA">

        <Border x:Name="CardBorder"
                Padding="8"
                CornerRadius="8"
                Background="White"
                BorderBrush="#20B14A"
                BorderThickness="0.5"
                Effect="{StaticResource CardShadow}">

            <Grid>

                <!--========================
                    ROWS
                ==========================-->

                <Grid.RowDefinitions>

                    <!-- Header -->
                    <RowDefinition Height="Auto"/>

                    <!-- Title -->
                    <RowDefinition Height="Auto"/>

                    <!-- Type/Schedule -->
                    <RowDefinition Height="Auto"/>

                    <!-- Progress -->
                    <RowDefinition Height="30"/>

                    <!-- Footer -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <!--====================================================
                    HEADER
                =====================================================-->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition/>

                        <ColumnDefinition Width="35"/>

                    </Grid.ColumnDefinitions>

                    <!-- Running Badge -->

                    <Border Background="#E9F8ED"
                            CornerRadius="11"
                            Height="24"
                            Width="78"
                            HorizontalAlignment="Left">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="{Binding Status, TargetNullValue='Loading..'}"
                                       FontSize="10" d:Text="Running"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding StatusColor}" d:Foreground="#179C38"
                                       VerticalAlignment="Center"/>

                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{Binding StatusColor}" d:Fill="#179C38"
                                     Margin="6,0,0,0"/>

                        </StackPanel>

                    </Border>

                    <!-- Three Dot Menu -->

                    <Button Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontSize="24"
                            Content="⋮"
                            Foreground="#666" Click="MenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource ProfessionalContextMenu}">
                                <MenuItem Header="Edit Properties" 
                      Style="{StaticResource ProfessionalMenuItem}"/>
                                <MenuItem Header="Share Link" 
                      Style="{StaticResource ProfessionalMenuItem}" />

                                <!-- Professional line divider -->
                                <Separator Style="{StaticResource ProfessionalSeparator}"/>

                                <MenuItem Header="Delete Item" 
                      Style="{StaticResource ProfessionalMenuItem}" 
                      Foreground="#DC2626" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                </Grid>

                <!--====================================================
                    BODY COMING NEXT
                =====================================================-->

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="DatabaseClock" FontSize="38" Foreground="#337ef5" />
                    <StackPanel Height="45" Margin="5,0">
                        <TextBlock Text="{Binding JobName, TargetNullValue='--'}" d:Text="Job" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DatabaseName,TargetNullValue='--'}" d:Text="Database" FontSize="14" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="5,0" HorizontalAlignment="Left">
                    <TextBlock Text="Type"  FontWeight="SemiBold" Foreground="Gray"/>
                    <TextBlock Text="{Binding JobType,TargetNullValue='--'}" d:Text="Full Backup" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="5,0" HorizontalAlignment="Right">
                    <TextBlock Text="Scheduled"  FontWeight="SemiBold" Foreground="Gray"/>
                    <TextBlock Text="{Binding ScheduledMessage,TargetNullValue='--'}" d:Text="Daily at 11:00 AM " FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar  Minimum="0" 
                        Maximum="100" 
                        Value="{Binding Percent}" 
                        Width="290" 
                        Height="4" />
                    <TextBlock Text="{Binding Percent, StringFormat={}{0}%, TargetNullValue='--'}" TextAlignment="Center" Width="30" d:Text="0%" FontWeight="SemiBold" Margin="5,0"/>
                </StackPanel>


                <StackPanel Grid.Row="4" Margin="5,0" HorizontalAlignment="Left" Orientation="Horizontal">
                    <TextBlock Text="Progress :"  FontWeight="SemiBold" Foreground="Gray"/>
                    <TextBlock Text="{Binding Progress,TargetNullValue='--'}" d:Text="100mb/100gb" FontWeight="SemiBold" Width="100"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Margin="5,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="Speed: "  FontWeight="SemiBold" Foreground="Gray"/>
                    <TextBlock Text="{Binding Speed,TargetNullValue='--'}" d:Text="100 mb/s " FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="5,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Text="ETA: "  FontWeight="SemiBold" Foreground="Gray"/>
                    <TextBlock Text="{Binding Eta,TargetNullValue='--'}" d:Text="1 hour " FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="5,0" HorizontalAlignment="Left">
                    <TextBlock Text="Started"  FontWeight="SemiBold" Foreground="Gray"/>
                    <TextBlock Text="{Binding ScheduledAt,TargetNullValue='--'}" d:Text="11:00 AM " FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="5,0" HorizontalAlignment="Center">
                    <TextBlock Text="Finished"  FontWeight="SemiBold" Foreground="Gray"/>
                    <TextBlock Text="{Binding LastRunAt,TargetNullValue='--'}" d:Text="12:00 PM" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="5,0" HorizontalAlignment="Right">
                    <TextBlock Text="Next Run"  FontWeight="SemiBold" Foreground="Gray"/>
                    <TextBlock Text="{Binding NextRunAt,TargetNullValue='--'}" d:Text="01:00 AM" FontWeight="SemiBold"/>
                </StackPanel>

                <Border Grid.Row="6" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ClockOutline" FontSize="18" Foreground="Gray"/>
                        <TextBlock Text="{Binding Message}" d:Text="--"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="6" HorizontalAlignment="Right" Padding="7,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button HorizontalAlignment="Right" Background="Transparent">
                            <materialIcons:MaterialIcon Kind="Stop" FontSize="22" Foreground="Red"/>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>

        </Border>

    </Grid>
</UserControl>
