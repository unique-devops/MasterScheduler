<Window x:Class="MasterScheduler.Views.LocalPathBackupConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterScheduler.Views"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        Title="LocalPath Configuration" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow" Height="350" Width="550">
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="5">
            <TextBlock Text="Folder location:" FontSize="16"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="txtPath" Text="{Binding TargetPath}" Width="500">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <Button x:Name="btnBrowsePath" Click="btnBrowsePath_Click" Background="Transparent" Margin="5,0" BorderThickness="0">
                    <Image Source="/Assets/folder.png" Height="32" Width="32"/>
                </Button>
            </StackPanel>
        </StackPanel>
        <GroupBox Grid.Row="1" Header="Authentication" FontSize="16">
            <StackPanel Margin="5">
                <!--<TextBlock Text="Network credentials (optional)" FontSize="16"/>-->
                <CheckBox IsChecked="{Binding IsNetwork}" Content="Network credentials (optional)" FontSize="16"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,5" Text="Username :" FontSize="16"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,5" FontSize="18" x:Name="txtUser" Text="{Binding Username}">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Password :" FontSize="16"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtPassword" Text="{Binding Password}" FontSize="18">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
               
                </Grid>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="Common settings" FontSize="16">
            <StackPanel Margin="5" Orientation="Horizontal">
                <TextBlock  Text="Delete backup older than" FontSize="16"/>
                <TextBox Margin="5,0" Width="80" FontSize="18"  Text="{Binding RetentionDays}">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Days." FontSize="16"/>
            </StackPanel>
        </GroupBox>
        <Grid Grid.Row="4" Background="Black">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40"/>
            <!-- Empty space (right) to balance layout -->
            <Border Grid.Column="1" Width="40"/>

            <Button x:Name="btnSave" Grid.Column="2" Background="Black" Margin="5"
         Foreground="White" FontWeight="Bold" Cursor="Hand" Width="100" Click="btnSave_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Save" Margin="0,0,7,0" />
                    <fa:ImageAwesome Icon="Save" Foreground="White" VerticalAlignment="Center" Width="16" Height="16" Margin="0,0,5,0"/>
                </StackPanel>
            </Button>

            <Button x:Name="btnCancel" Grid.Column="3" Background="Black" Margin="5"
    Foreground="White" FontWeight="Bold" Cursor="Hand" Width="100" Click="btnCancel_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cancel" Margin="0,0,7,0" />
                    <fa:ImageAwesome Icon="Remove" Foreground="White" VerticalAlignment="Center" Width="16" Height="16" Margin="0,0,5,0"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
