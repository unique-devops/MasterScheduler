<UserControl x:Class="MasterScheduler.Views.SQLBackupScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:local="clr-namespace:MasterScheduler.Views"
             xmlns:ctr="clr-namespace:MasterScheduler.Converter"
             mc:Ignorable="d" x:Name="RootControl"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="Black">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Foreground="White" Background="Transparent" Command="{Binding GoBackCommand}" Width="50">
                <fa:ImageAwesome Icon="ArrowLeft" Foreground="White" VerticalAlignment="Center" Width="16" Height="16" Margin="0,0,5,0"/>
            </Button>
            <!-- Centered Title -->
            <TextBlock Grid.Column="1" Text="SQL Backup Schedule" Foreground="White"
                FontSize="20" FontWeight="Bold" 
                VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <!-- Empty space (right) to balance layout -->
            <Border Grid.Column="2" Width="40"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock  Text="Job Name:" Margin="5" Foreground="Black" FontSize="18" VerticalAlignment="Center"/>
            <TextBox Width="250" Margin="2" Padding="2" Text="{Binding JobAliasName}" FontSize="18" FontWeight="SemiBold" VerticalContentAlignment="Center">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="7"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
        </StackPanel>
        <Grid Grid.Row="2">
            <ListBox Grid.Row="1" HorizontalContentAlignment="Stretch" >
                <!--connect server-->
                <ListBoxItem >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Grid.Column="0" Icon="Server" Foreground="Black" Width="35" Height="35"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="Bold" Text="Connect to the MSSQL Server" Margin="5"/>
                            <TextBlock Text="{Binding ServerName}" Margin="5"/>
                        </StackPanel>
                        <Button Grid.Column="2" Width="24" Height="24" Background="Transparent" BorderThickness="0" Command="{Binding ConnectServerCommand}" >
                            <fa:ImageAwesome  Icon="Gear" Foreground="Gray" />
                        </Button>

                    </Grid>
                </ListBoxItem>
                <!--choose database-->
                <ListBoxItem>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Grid.Column="0" Icon="Database" Foreground="Black" Width="35" Height="35" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="Bold" Text="Selected Databases" Margin="5"/>
                            <ItemsControl ItemsSource="{Binding SelectedDatabases}" Margin="10,5" Width="250" HorizontalAlignment="Left">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="2,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Button Grid.Column="2" Width="22" Height="22" Background="Transparent" BorderThickness="0" Command="{Binding OpenDatabaseSelectionCommand}" VerticalAlignment="Top">
                            <fa:ImageAwesome  Icon="PlusCircle" Foreground="Gray" />
                        </Button>

                    </Grid>
                </ListBoxItem>
                <!--config destinations-->
                <ListBoxItem >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Grid.Column="0" Icon="Cloud" Foreground="Black" Width="35" Height="35" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="Bold" Text="Set backup destinations" Margin="5"/>
                            <ListBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}"
                                     BorderThickness="1" Margin="4,2" HorizontalAlignment="Left">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Width="500">
                                            <!-- Icon -->
                                            <Image Width="18" Height="18" HorizontalAlignment="Left"  Source="{Binding Type, Converter={StaticResource IconConverter}}"/>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding PathOrEndpoint}"
                                                FontSize="11" Foreground="Gray"
                                                TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <!-- Action Button -->
                                            <Menu HorizontalAlignment="Right">
                                                <MenuItem BorderThickness="0" BorderBrush="Transparent">
                                                    <MenuItem.Header>
                                                        <Image Source="/Assets/ellipse.png" Width="18" Height="18"/>
                                                    </MenuItem.Header>
                                                    <MenuItem Header="Config" Command="{Binding DataContext.ConfigureDestinationCommand, ElementName=RootControl}"
                                                        CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Delete" Command="{Binding DataContext.DeleteCommand, ElementName=RootControl}"
                                                        CommandParameter="{Binding}"/>
                                                </MenuItem>
                                            </Menu>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <Button Grid.Column="2" Width="22" Height="22" Background="Transparent" BorderThickness="0"
                                x:Name="btnBackupDestiny" Click="btnBackupDestiny_Click" VerticalAlignment="Top">
                            <fa:ImageAwesome  Icon="PlusCircle" Foreground="Gray"/>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="LocalFolder" Header="Local Folder" Click="MenuItem_Click"  />
                                    <MenuItem x:Name="GoogleDrive" Header="Google Drive" Click="MenuItem_Click"  />
                                    <MenuItem x:Name="FTP" Header="FTP" Click="MenuItem_Click"  />
                                    <MenuItem x:Name="SFTP" Header="SFTP" Click="MenuItem_Click"  />
                                    <MenuItem x:Name="OneDrive" Header="OneDrive" Click="MenuItem_Click"  />
                                    <MenuItem x:Name="AmazonS3" Header="Amazon S3" Click="MenuItem_Click"  />
                                    <MenuItem x:Name="AzureBlob" Header="Azure Blob" Click="MenuItem_Click"  />
                                    <MenuItem x:Name="NetworkShare" Header="NAS / Network Share" Click="MenuItem_Click"  />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                    </Grid>
                </ListBoxItem>
                <!--schedule Time-->
                <ListBoxItem>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Grid.Column="0" Icon="ClockOutline" Foreground="Black" Width="35" Height="35"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="Bold" Text="Schedule backups" Margin="5"/>
                            <TextBlock Text="{Binding ScheduledTime}" Margin="5"/>
                        </StackPanel>
                        <Button Grid.Column="2" Width="24" Height="24" Background="Transparent" BorderThickness="0" Command="{Binding SchedulerSettingsCommand}" >
                            <fa:ImageAwesome  Icon="Gear" Foreground="Gray" />
                        </Button>

                    </Grid>
                </ListBoxItem>
                <!--alert notify-->
                <ListBoxItem>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Grid.Column="0" Icon="Wechat" Foreground="Black" Width="35" Height="35"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="Bold" Text="Send Confirmation" Margin="5"/>
                            <TextBlock Text="default" Margin="5"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" TextAlignment="Center">
                            <Hyperlink TextDecorations="None" Background="Transparent">
                                <InlineUIContainer>
                                    <fa:ImageAwesome  Icon="Gear" Foreground="Gray" Width="22" Height="22"/>
                                </InlineUIContainer>
                            </Hyperlink>
                        </TextBlock>

                    </Grid>
                </ListBoxItem>
            </ListBox>
        </Grid>

        <!--footer-->
        <Grid Grid.Row="3" Background="Black">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40"/>
            <!-- Empty space (right) to balance layout -->
            <Border Grid.Column="1" Width="40"/>

            <Button Grid.Column="2" Background="Black" Margin="5"
                 Foreground="White" FontWeight="Bold" Cursor="Hand" Command="{Binding SaveCommand}" Width="100">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Save" Margin="0,0,7,0" />
                    <fa:ImageAwesome Icon="Save" Foreground="White" VerticalAlignment="Center" Width="16" Height="16" Margin="0,0,5,0"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Background="Black" Margin="5"
            Foreground="White" FontWeight="Bold" Cursor="Hand" Command="{Binding CancelCommand}" Width="100">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cancel" Margin="0,0,7,0" />
                    <fa:ImageAwesome Icon="Remove" Foreground="White" VerticalAlignment="Center" Width="16" Height="16" Margin="0,0,5,0"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
