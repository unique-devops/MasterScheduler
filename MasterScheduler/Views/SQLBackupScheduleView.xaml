<UserControl x:Class="MasterScheduler.Views.SQLBackupScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             x:Name="RootControl">

    <UserControl.Resources>
        <Style x:Key="ListItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" 
                            Background="White" 
                            CornerRadius="8" 
                            BorderThickness="1" 
                            BorderBrush="#E0E0E0" 
                            Margin="10,4"
                            Padding="15,10">

                            <ContentPresenter />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#0078D7" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FAFAFA" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F0F7FF" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#0078D7"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ListItemStyle2" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" 
                    Background="White" 
                    CornerRadius="4" 
                    BorderThickness="1" 
                    BorderBrush="#E0E0E0" 
                    Margin="5,1"
                    Padding="0,4">

                            <ContentPresenter />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F0F7FF" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#0078D7"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="False">
                                <Setter Property="IsSelected" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="12" Background="Transparent" Width="30" Height="30">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#E0E0E0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="JobToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Border x:Name="Background" Width="35" Height="18" CornerRadius="9" Background="#CBD5E1" BorderThickness="0">
                                    <Ellipse x:Name="Dot" Width="14" Height="14" HorizontalAlignment="Left" Margin="2,0" Fill="White">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </BulletDecorator.Bullet>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#22C55E"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="17" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F6F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="White">
            <Button HorizontalAlignment="Left" Style="{StaticResource IconButton}" Margin="10,0" Command="{Binding GoBackCommand}">
                <fa:ImageAwesome Icon="ArrowLeft" Foreground="#333" Width="14"/>
            </Button>
            <TextBlock Text="SQL Backup Schedule" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Border BorderThickness="0,0,0,1" BorderBrush="#DDD" VerticalAlignment="Bottom"/>
        </Grid>

        <Border Grid.Row="1" Background="White" Margin="10,15,10,5" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Margin="15,5" Orientation="Horizontal">
                <TextBlock Text="JOB NAME :" FontSize="12" FontWeight="Bold" Foreground="Blue" Margin="2,0"/>
                <TextBox Text="{Binding JobAliasName, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="14" BorderThickness="0" Foreground="Red" Background="Transparent" FontWeight="Medium"/>
            </StackPanel>
        </Border>

        <ListBox Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionMode="Single">

            <ListBoxItem Style="{StaticResource ListItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#E3F2FD" CornerRadius="20" Width="40" Height="40">
                        <fa:ImageAwesome Icon="Server" Foreground="#1976D2" Width="18"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="SQL Server Instance" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ServerName, TargetNullValue='Not Connected'}" Foreground="Gray" FontSize="12"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding ConnectServerCommand}">
                        <fa:ImageAwesome Icon="Gear" Foreground="#777" Width="16"/>
                    </Button>
                </Grid>
            </ListBoxItem>

            <ListBoxItem Style="{StaticResource ListItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#E8F5E9" CornerRadius="20" Width="40" Height="40">
                        <fa:ImageAwesome Icon="Database" Foreground="#388E3C" Width="18"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="Databases" FontWeight="Bold"/>
                        <TextBlock Visibility="Collapsed" Text="Click plus to select databases" Foreground="Gray" FontSize="12"/>
                        <ItemsControl ItemsSource="{Binding SelectedDatabases}" Margin="10,5" Width="250" HorizontalAlignment="Left">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="2,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding OpenDatabaseSelectionCommand}">
                        <fa:ImageAwesome Icon="PlusCircle" Foreground="#777" Width="16"/>
                    </Button>
                </Grid>
            </ListBoxItem>

            <ListBoxItem Style="{StaticResource ListItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="LightSkyBlue" Grid.Column="0" CornerRadius="20" Width="40" Height="40">
                        <fa:ImageAwesome Icon="CloudUpload" Foreground="White" Width="18"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock FontWeight="Bold" Text="Set backup destinations"/>
                        <ListBox ItemsSource="{Binding Destinations}"
                                 SelectedItem="{Binding SelectedDestination}"
                                 Visibility="{Binding HasDestination,Converter={StaticResource BoolToVisibilityConverter}}" Background="Transparent" BorderThickness="0" SelectionMode="Single" HorizontalAlignment="Left">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItemStyle2}">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Width="500">
                                        <!-- Icon -->
                                        <Image Width="18" Height="18" Margin="5,0" HorizontalAlignment="Left"  Source="{Binding Type, Converter={StaticResource IconConverter}}"/>
                                        <!--<fa:ImageAwesome  Width="18" Height="18" Margin="5,0" HorizontalAlignment="Left" Icon="{Binding Type, Converter={StaticResource IconConverter}}" />-->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Type}" FontWeight="Bold" Margin="5,0"/>
                                            <TextBlock Text="{Binding DisplayText}"
                                                FontSize="12" Foreground="Gray"
                                                TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <!-- Action Button -->
                                        <Menu HorizontalAlignment="Right">
                                            <MenuItem BorderThickness="0" Background="White" BorderBrush="Transparent">
                                                <MenuItem.Header>
                                                    <Image Source="/Assets/ellipse.png" Width="18"/>
                                                </MenuItem.Header>
                                                <MenuItem Header="Config" Command="{Binding DataContext.ConfigureDestinationCommand, ElementName=RootControl}"
                                                        CommandParameter="{Binding}"/>
                                                <MenuItem Header="Delete" Command="{Binding DataContext.DeleteCommand, ElementName=RootControl}"
                                                        CommandParameter="{Binding}"/>
                                            </MenuItem>
                                        </Menu>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                            x:Name="btnBackupDestiny"
                            Click="btnBackupDestiny_Click">
                        <fa:ImageAwesome  Icon="PlusCircle" Foreground="#777" Width="16"/>
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding AvailableDestinations}">
                                <ContextMenu.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="16"
                                               Height="16"
                                               Margin="0,0,8,0"
                                               Source="{Binding IconPath}"/>
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text=" 🔒"   Foreground="#999"  Visibility="{Binding IsActive, Converter={StaticResource FalseToVisibleConverter}}"/>

                                        </StackPanel>
                                    </DataTemplate>
                                </ContextMenu.ItemTemplate>
                                
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Icon" Value="{x:Null}"/>
                                        <Setter Property="Command" Value="{Binding DataContext.SelectDestinationCommand, 
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Setter Property="CommandParameter" Value="{Binding}"/>

                                        <!--<Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="InputGestureText" Value="🔒"/>
                                                <Setter Property="Opacity" Value="0.7"/>
                                            </DataTrigger>
                                        </Style.Triggers>-->
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <!--<Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="LocalFolder" Header="Local Folder" Click="MenuItem_Click"  >
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/folder.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="GoogleDrive" Header="Google Drive" Click="MenuItem_Click"  >
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/google-drive.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="FTP" Header="FTP" Click="MenuItem_Click"  >
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/ftp.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="SFTP" Header="SFTP" Click="MenuItem_Click"  >
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/sftp.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="OneDrive" Header="OneDrive" Click="MenuItem_Click"  >
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/onedrive.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="AmazonS3" Header="Amazon S3" Click="MenuItem_Click"  >
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/s3.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="AzureBlob" Header="Azure Blob" Click="MenuItem_Click"  >
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/azure.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="NetworkShare" Header="NAS / Network Share" Click="MenuItem_Click"  >
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/local-area-network.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>-->
                    </Button>

                </Grid>
            </ListBoxItem>

            <ListBoxItem Style="{StaticResource ListItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#FFF3E0" CornerRadius="20" Width="40" Height="40">
                        <fa:ImageAwesome Icon="ClockOutline" Foreground="#F57C00" Width="18"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="Execution Schedule" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ScheduledTime, FallbackValue='Every Day at 12:00 AM'}" Foreground="Gray" FontSize="12"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding SchedulerSettingsCommand}">
                        <fa:ImageAwesome Icon="Gear" Foreground="#777" Width="16"/>
                    </Button>
                </Grid>
            </ListBoxItem>
            
            <ListBoxItem Style="{StaticResource ListItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#FFF3E0" CornerRadius="20" Width="40" Height="40">
                        <fa:ImageAwesome Icon="EnvelopeOutline" Foreground="#F57C00" Width="18"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="Send Confirmation Mail" FontWeight="Bold"/>
                        <TextBox Text="{Binding SendConfirmationMail}" FontSize="14" Foreground="Gray" BorderThickness="0" Background="Transparent" FontWeight="Medium"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2" IsChecked="{Binding ActiveAlert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        Style="{StaticResource JobToggleStyle}"                        
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </ListBoxItem>
        </ListBox>

        <Grid Grid.Row="3" Background="White">
            <!--<Border BorderThickness="0,1,0,0" BorderBrush="#DDD" VerticalAlignment="Top"/>-->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="2">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="100" Margin="5" 
                        Background="IndianRed" Foreground="White" FontWeight="Bold" BorderBrush="#DDD" Height="35">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Style.Setters>
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style.Setters>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Save Job" Command="{Binding SaveCommand}" Width="120" Margin="5" 
                        Background="#0078D7" Foreground="White" BorderThickness="0" Height="35" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Style.Setters>
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style.Setters>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>